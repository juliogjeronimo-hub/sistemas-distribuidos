# Build outputs — never ship intermediate artifacts into the image
**/bin
**/obj

# Version control
.git
**/.gitignore
**/.gitkeep

# Node (labs, tooling)
**/node_modules

# IDE and user files
**/*.user
**/*.suo
**/.vs
.vscode
.idea

# Kiro agent internals
.kiro

# Local secrets (never leak into the build context)
**/*.pfx
**/*.p12
**/appsettings.Development.json
**/secrets.json

# Test results
**/TestResults
**/coverage

# Documentation and non-runtime assets
docs
labs
README.md
PLANO.md
