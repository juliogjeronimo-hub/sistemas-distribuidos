<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <!-- YARP reverse proxy — edge routing to downstream services (Req. 2, 3) -->
    <PackageReference Include="Yarp.ReverseProxy" Version="2.3.0" />
    <!-- JWT bearer authentication against Keycloak (Req. 2, 3) -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- OpenTelemetry — traces, metrics and Prometheus scrape endpoint (Req. 4, 5) -->
    <!-- Hosting integration: registers OtelSdk lifetime with IHostedService -->
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.20.1" />
    <!-- ASP.NET Core instrumentation: HTTP server metrics and spans -->
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.20.0" />
    <!-- .NET runtime instrumentation: GC, thread-pool, exception metrics -->
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" Version="1.20.0" />
    <!-- HTTP client instrumentation: outbound proxy spans and context propagation -->
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.20.0" />
    <!-- Prometheus exporter: exposes /metrics scrape endpoint (still beta, no stable release exists) -->
    <PackageReference Include="OpenTelemetry.Exporter.Prometheus.AspNetCore" Version="1.20.0-beta.1" />
  </ItemGroup>

</Project>
