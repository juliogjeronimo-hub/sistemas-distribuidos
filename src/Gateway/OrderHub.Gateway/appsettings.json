{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "Auth": {
    "Authority": "http://localhost:8080/realms/orderhub",
    "Audience": "orderhub-api",
    "RequireHttpsMetadata": false
  },
  "Telemetry": {
    "ServiceName": "gateway",
    "ServiceVersion": "1.0.0"
  },
  "ReverseProxy": {
    "Routes": {
      "catalog": {
        "ClusterId": "catalog",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/catalog/{**remainder}"
        },
        "Transforms": [
          { "PathPattern": "/v1/{**remainder}" }
        ]
      }
    },
    "Clusters": {
      "catalog": {
        "Destinations": {
          "catalog": {
            "Address": "http://localhost:5001/"
          }
        },
        "HttpRequest": {
          "ActivityTimeout": "00:00:05"
        }
      }
    }
  }
}
